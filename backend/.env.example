# Copy this file to ".env" and fill in your own values.

# Local MongoDB:   mongodb://127.0.0.1:27017/drug-inventory
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster-url>/drug-inventory
MONGO_URI=mongodb://127.0.0.1:27017/drug-inventory

# Any long random string works. This signs your login tokens (JWT).
JWT_SECRET=change_this_to_a_long_random_secret

# Port the server runs on
PORT=5000

# ---------- E-mail alerts (optional) ----------
# Option A: Gmail on your laptop. Use a Gmail "App Password" (16 letters), NOT your normal password.
EMAIL_USER=yourname@gmail.com
EMAIL_PASS=abcdefghijklmnop
# Who receives the alerts (comma separated). If empty, EMAIL_USER receives them.
ALERT_EMAIL_TO=yourname@gmail.com

# Option B: Brevo, for Render's free plan (Render blocks Gmail SMTP). If BREVO_API_KEY is set it is used instead of Gmail.
# EMAIL_FROM must be a sender address you verified inside Brevo.
# BREVO_API_KEY=
# EMAIL_FROM=

# How often the app checks stock and e-mails the list (hours). 0 switches the scheduled check off.
ALERT_INTERVAL_HOURS=24
